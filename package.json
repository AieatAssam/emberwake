{
  "name": "emberwake",
  "version": "1.0.0",
  "description": "Emberwake — a bullet-heaven survival roguelite. Carry the last Ember through the Gloam.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:js": "eslint . --max-warnings 0",
