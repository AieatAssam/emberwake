    "globals": "^17.13.0",
    "html-validate": "^11.16.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.3.3"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
